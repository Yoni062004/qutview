# Copy this file to .env and fill in your keys.
# Register free at https://comtradeplus.un.org (removes preview rate limits).
COMTRADE_API_KEY=paste_your_key_here

# Anthropic API key for the LLM-written corridor briefs (src/brief/).
# Without it the briefs still work in deterministic template mode.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=paste_your_key_here
# Optional: override the Claude model used for briefs.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: demo-grade password gate for the dashboard. If set, the app asks
# for it once per session. Leave unset for an open demo. Not production auth.
# QUTVIEW_PASSWORD=choose_a_password

# Optional: SMTP settings to live-send the alert-digest email. The digest
# always previews in the dashboard; these only enable the "Send digest now"
# button. For Gmail, use an App Password (not your account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your_app_password
# ALERT_FROM=you@example.com
# ALERT_TO=recipient1@example.com,recipient2@example.com
