# Copy this file to .env and fill in your keys.
# Register free at https://comtradeplus.un.org (removes preview rate limits).
COMTRADE_API_KEY=paste_your_key_here

# Anthropic API key for the LLM-written corridor briefs (src/brief/).
# Without it the briefs still work in deterministic template mode.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=paste_your_key_here
# Optional: override the Claude model used for briefs.
# ANTHROPIC_MODEL=claude-sonnet-5
